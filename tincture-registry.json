  "neverRegistered": [
    {
      "name": "DES and 3DES",
      "aliases": [
        "DES",
        "3DES",
        "TDES",
        "TripleDES",
        "DESede"
      ],
      "reason": "Obsolete 64-bit block ciphers."
    },
    {
      "name": "RC4",
      "aliases": [
        "RC4",
        "ARCFOUR"
      ],
      "reason": "Broken stream cipher."
    },
    {
      "name": "AES-ECB",
      "aliases": [
        "AES-ECB",
        "AES_ECB"
      ],
      "reason": "Leaks plaintext structure; no authentication."
    },
    {
      "name": "Unauthenticated AES-CBC or AES-CTR",
      "aliases": [
        "AES_CBC_256",
        "AES-CBC",
        "AES-256-CBC",
        "AES-CTR"
      ],
      "reason": "No integrity; padding-oracle exposure."
    },
    {
      "name": "MD5",
      "aliases": [
        "MD5"
      ],
      "reason": "Collisions are practical."
    },
    {
      "name": "SHA-1",
      "aliases": [
        "SHA1",
        "SHA-1"
      ],
      "reason": "Collisions are practical (verify-only exceptions need an ADR)."
    },
    {
      "name": "RSA PKCS #1 v1.5 encryption",
      "aliases": [
        "RSAES-PKCS1-v1_5"
      ],
      "reason": "Padding-oracle attacks (Bleichenbacher); use HPKE sealed-to suites."
    },
    {
      "name": "RSA below 3072 bits",
      "aliases": [
        "RSA1024",
        "RSA-1024",
        "RSA2048",
        "RSA-2048"
      ],
      "reason": "Below 128-bit security (NIST SP 800-57 Part 1); Tincture registers no RSA key under 3072 bits."
    },
    {
      "name": "Custom or unpublished primitives",
      "aliases": [
        "WhiteBox_AES_128",
        "WhiteBox_AES_256"
      ],
      "reason": "Only published primitives with public test vectors are registered."
    }
  ],
